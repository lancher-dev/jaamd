{
  "name": "@lancher-dev/jaamd",
  "version": "0.7.0",
  "description": "Add remark plugins, client-side enhancements and styles as a single Astro integration for Markdown content.",
  "type": "module",
  "license": "MIT",
  "author": "Kasui92 <info@lucapattocchio.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lancher-dev/jaamd.git"
  },
  "homepage": "https://github.com/lancher-dev/jaamd#readme",
  "bugs": {
    "url": "https://github.com/lancher-dev/jaamd/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "withastro",
    "markdown",
    "remark"
  ],
  "exports": {
    ".": "./index.ts",
    "./components": "./src/components/MarkdownContent.astro",
    "./client": "./src/scripts/enhancements.ts",
    "./default": "./src/styles/variables.css",
    "./default.css": "./src/styles/variables.css",
    "./styles": "./src/styles/markdown.css",
    "./styles.css": "./src/styles/markdown.css",
    "./shiki-dual": "./src/styles/shiki-dual.css",
    "./shiki-dual.css": "./src/styles/shiki-dual.css",
    "./themes/dracula": "./src/themes/dracula/index.css",
    "./themes/dracula.css": "./src/themes/dracula/index.css",
    "./themes/dracula/dark": "./src/themes/dracula/dark.css",
    "./themes/dracula/dark.css": "./src/themes/dracula/dark.css",
    "./themes/nord": "./src/themes/nord/index.css",
    "./themes/nord.css": "./src/themes/nord/index.css",
    "./themes/nord/dark": "./src/themes/nord/dark.css",
    "./themes/nord/dark.css": "./src/themes/nord/dark.css",
    "./themes/one-dark": "./src/themes/one-dark/index.css",
    "./themes/one-dark.css": "./src/themes/one-dark/index.css",
    "./themes/one-dark/dark": "./src/themes/one-dark/dark.css",
    "./themes/one-dark/dark.css": "./src/themes/one-dark/dark.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "example": "cd example && npm run dev",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "astro": "^7.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.0"
  }
}
