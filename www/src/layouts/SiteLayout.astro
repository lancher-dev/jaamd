---
import "@lancher-dev/jaamd/default.css";
import "@lancher-dev/jaamd/styles.css";
import "@lancher-dev/jaamd/themes/one-dark/dark.css";
import "../styles/site.css";

const title = "JAAMD — Just Another Astro Markdown";
const description =
  "Remark plugins, client-side enhancements and styles as a single Astro integration for Markdown content.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/favicon.svg", Astro.site).href;

// Inline and before paint: a class set from a module would flash the wrong theme.
const themeScript = `(function () {
  var t = localStorage.getItem("theme");
  if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
    document.documentElement.classList.add("dark");
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/">JAAMD</a>
      <nav aria-label="Main">
        <a href="https://github.com/lancher-dev/jaamd">GitHub</a>
        <a href="https://www.npmjs.com/package/@lancher-dev/jaamd">npm</a>
      </nav>
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM11 1h2v3h-2V1Zm0 19h2v3h-2v-3ZM3.5 4.9 4.9 3.5 7 5.6 5.6 7 3.5 4.9Zm13.4 12L18.4 17l2.1 2.1-1.4 1.4-2.2-2.1ZM19.1 3.5l1.4 1.4L18.4 7 17 5.6l2.1-2.1ZM5.6 17 7 18.4 4.9 20.5 3.5 19.1 5.6 17ZM23 11v2h-3v-2h3ZM4 11v2H1v-2h3Z"
          ></path>
        </svg>
      </button>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        MIT — built by <a href="https://lucapattocchio.dev">Luca Pattocchio</a>.
        This page is rendered with JAAMD itself.
      </p>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>
