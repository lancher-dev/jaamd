---
import { createRequire } from "node:module";
import { readFileSync } from "node:fs";
import { Font } from "astro:assets";
import { themes as packageThemes } from "@lancher-dev/jaamd/themes";
import "@lancher-dev/jaamd/default.css";
import "@lancher-dev/jaamd/styles.css";
import "../styles/identity.css";
import "../styles/jaamd.css";
import "../styles/site.css";
import SiteThemePicker from "../components/SiteThemePicker.astro";
import { themeModes, THEME_STORAGE_KEY, SITE_THEME } from "../themes.ts";

const require = createRequire(import.meta.url);

// Themes are authored on :root, so importing more than one would just let the
// last win. Re-scoped here, at build time, so they can coexist and be switched.
const themeCss = packageThemes
  .map(({ slug }) => {
    const source = readFileSync(
      require.resolve(`@lancher-dev/jaamd/themes/${slug}.css`),
      "utf8",
    );
    const scope = `html[data-jaamd-theme="${slug}"]`;

    // Shiki bakes one variable per configured theme; this picks which one the
    // code reads. More specific than shiki-dual.css, so injection order is moot.
    const code = `${scope}.dark .jaamd-content .astro-code span,
${scope}.dark .jaamd-content .shiki span {
  color: var(--shiki-${slug}) !important;
  font-style: var(--shiki-${slug}-font-style) !important;
  font-weight: var(--shiki-${slug}-font-weight) !important;
  text-decoration: var(--shiki-${slug}-text-decoration) !important;
}`;

    return `${source.replace(/^:root \{$/m, `${scope} {`)}\n${code}`;
  })
  .join("\n\n");

const title = "JAAMD";
const description =
  "Remark plugins, client-side enhancements and styles as a single Astro integration for Markdown content.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;

// Inline and before paint: applied from a module, the wrong theme would flash.
const themeScript = `(function () {
  var modes = ${JSON.stringify(themeModes)};
  var slug;
  try { slug = localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)}); } catch (e) {}
  if (!modes[slug]) slug = ${JSON.stringify(SITE_THEME.slug)};

  var mode = modes[slug];
  var dark = mode === "dark" ||
    (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches);

  document.documentElement.dataset.jaamdTheme = slug;
  document.documentElement.classList.toggle("dark", dark);
})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-merriweather" preload />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline set:html={themeCss}></style>
    <script is:inline set:html={themeScript} />
  </head>
  <body data-site-layout>
    <header class="site-chrome site-header">
      <a class="site-brand font-brand" href="/">JAAMD</a>
      <div class="site-header-actions">
        <nav aria-label="Main navigation">
          <a href="https://github.com/lancher-dev/jaamd">GitHub</a>
          <a href="https://www.npmjs.com/package/@lancher-dev/jaamd">npm</a>
        </nav>
        <SiteThemePicker />
      </div>
    </header>

    <main class="site-main"><slot /></main>

    <footer class="site-chrome site-footer">
      JAAMD is released under the MIT License.
    </footer>
  </body>
</html>
