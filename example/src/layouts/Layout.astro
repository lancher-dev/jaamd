---
import "@lancher-dev/jaamd/default.css";
import "@lancher-dev/jaamd/styles.css";
import "@lancher-dev/jaamd/themes/one-dark/dark.css";
import MarkdownContent from "@lancher-dev/jaamd/components";

export interface Props {
  title?: string;
  frontmatter?: { title?: string };
}

const { title, frontmatter } = Astro.props;
const pageTitle = frontmatter?.title ?? title ?? "JAAMD Example";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
        document.documentElement.classList.add("dark");
    </script>
    <style>
      body {
        margin: 0;
        padding: 2rem;
        max-width: 800px;
        margin-inline: auto;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
      nav {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      nav a { color: #2d2d2d; text-decoration: none; font-weight: 500; }
      nav a:hover { text-decoration: underline; }
      html.dark body { background: #1e1e1e; color: #c9d1d9; }
      html.dark nav { border-color: #3d3d3d; }
      html.dark nav a { color: #c9d1d9; }
      #theme-toggle {
        margin-left: auto;
        cursor: pointer;
        background: none;
        border: 1px solid #ccc;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 14px;
      }
      html.dark #theme-toggle { border-color: #555; color: #c9d1d9; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/demo">Demo</a>
      <button id="theme-toggle">Toggle Dark/Light</button>
    </nav>
    <main>
      <MarkdownContent>
        <slot />
      </MarkdownContent>
    </main>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>
